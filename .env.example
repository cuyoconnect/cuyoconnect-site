# Redeploy automático (Vercel env + /api/trigger-redeploy)
# DEPLOY_TRIGGER_SECRET=
# VERCEL_DEPLOY_HOOK_URL=

# Aplicar webhook en Supabase (npm run db:redeploy-webhook): conexión Postgres directa
# (Dashboard → Settings → Database → Connection string → URI; no uses la anon key).
# DATABASE_URL=
# SUPABASE_DB_URL=
# Mismo secreto que DEPLOY_TRIGGER_SECRET en Vercel:
# DEPLOY_TRIGGER_SECRET=
# Opcional (default https://cuyoconnect.com/api/trigger-redeploy)
# CUYO_REDEPLOY_WEBHOOK_URL=

# Token de servidor para leer contribuciones públicas (GraphQL). El OAuth de
# miembros solo identifica quién está en la comunidad; no se usa para el mapa.
# GITHUB_TOKEN=

# Para persistir el mapa. En Vercel suele existir ya por /api/my-member-profile.
# Sin esto, el cron no puede guardar el snapshot.
# SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron envía Authorization: Bearer CRON_SECRET a /api/github-map-refresh
# (una vez al día). Si no está, también vale DEPLOY_TRIGGER_SECRET.
# CRON_SECRET=
