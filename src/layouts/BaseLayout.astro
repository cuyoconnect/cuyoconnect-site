---
import '../index.css'

interface Props {
  title: string
  description: string
  canonical: string
  ogImage?: string
  /** Ancho de og:image (por defecto 1920 para el asset horizontal del sitio). */
  ogImageWidth?: number
  /** Alto de og:image (por defecto 1080). */
  ogImageHeight?: number
  /** `summary` encaja mejor con avatares cuadrados (GitHub). */
  twitterCard?: 'summary' | 'summary_large_image'
  preloadHeroImage?: boolean
}

const {
  title,
  description,
  canonical,
  ogImage = '/cuyo-connect-og.webp',
  ogImageWidth = 1920,
  ogImageHeight = 1080,
  twitterCard = 'summary_large_image',
  preloadHeroImage = false,
} = Astro.props

const siteUrl = (
  import.meta.env.PUBLIC_SITE_URL ?? import.meta.env.VITE_SITE_URL ?? ''
)
  .trim()
  .replace(/\/$/, '')

function toAbsolute(url: string) {
  if (/^https?:\/\//i.test(url) || !siteUrl) return url
  return new URL(url, `${siteUrl}/`).toString()
}

const canonicalUrl = toAbsolute(canonical)
const ogImageUrl = toAbsolute(ogImage)
const ogUrl = canonicalUrl || toAbsolute(Astro.url.pathname)
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" sizes="882x882" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CuyoConnect" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    {
      ogImageUrl.startsWith('https://') ? (
        <meta property="og:image:secure_url" content={ogImageUrl} />
      ) : null
    }
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={`${title} — CuyoConnect`} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={ogUrl} />

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${title} — CuyoConnect`} />

    {preloadHeroImage ? (
      <link
        rel="preload"
        as="image"
        href="/cuyo-connect-hero.webp"
        fetchpriority="high"
      />
    ) : null}

  </head>
  <body>
    <slot />
  </body>
</html>
