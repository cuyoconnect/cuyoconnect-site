---
import LandingPage from '@/components/LandingPage.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = 'Eventos — CuyoConnect'
const description =
  'Calendario de meetups, workshops y encuentros presenciales de la comunidad CuyoConnect.'
---

<BaseLayout title={title} description={description} canonical="/eventos" preconnectAvatars>
  <LandingPage pathname="/eventos" targetId="eventos" />
</BaseLayout>
