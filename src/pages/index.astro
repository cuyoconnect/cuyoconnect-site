---
import LandingPage from '@/components/LandingPage.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = 'CuyoConnect'
const description =
  'Aprendé, construí y conectá con la comunidad tech de Cuyo. Eventos, hackatones y meetups presenciales en Mendoza.'
---

<BaseLayout
  title={title}
  description={description}
  canonical="/"
  preloadHeroImage
>
  <LandingPage pathname="/" />
</BaseLayout>
