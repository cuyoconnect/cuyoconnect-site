---
import LandingPage from '@/components/LandingPage.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = 'CuyoConnect'
const description =
  'Conocé a los miembros de CuyoConnect: aprendé, construí y conectá con la comunidad tech de Cuyo.'
---

<BaseLayout title={title} description={description} canonical="/" preconnectAvatars>
  <LandingPage pathname="/miembros" targetId="miembros" />
</BaseLayout>
