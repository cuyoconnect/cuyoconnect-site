---
import ProyectosPageIsland from '@/components/github-map/ProyectosPageIsland'
import { SiteHeader } from '@/SiteHeader'
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = 'Proyectos — CuyoConnect'
const description =
  'Mapa de proyectos publicados de la comunidad CuyoConnect: el área de cada región sigue los commits del último año.'
const supabaseUrl =
  import.meta.env.PUBLIC_SUPABASE_URL ?? import.meta.env.VITE_SUPABASE_URL ?? ''
const supabaseAnonKey =
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY ??
  import.meta.env.VITE_SUPABASE_ANON_KEY ??
  import.meta.env.VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY ??
  ''
---

<BaseLayout title={title} description={description} canonical="/proyectos">
  <SiteHeader client:load pathname="/proyectos" />
  <main>
    <ProyectosPageIsland
      client:only="react"
      supabaseUrl={supabaseUrl}
      supabaseAnonKey={supabaseAnonKey}
    >
      <div
        slot="fallback"
        class="bg-white px-4 pb-14 pt-24 sm:px-6 sm:pb-16 sm:pt-28"
        aria-hidden="true"
      >
        <div class="mt-6 h-[min(68vh,44rem)] w-full animate-pulse rounded-[45%] bg-[#f2efe6] sm:mt-8"></div>
      </div>
    </ProyectosPageIsland>
  </main>
</BaseLayout>
