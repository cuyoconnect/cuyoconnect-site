---
import SpeakersIsland from '@/components/SpeakersIsland'
import { SiteHeader } from '@/SiteHeader'
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = 'Speakers — CuyoConnect'
const description =
  'Enviá una propuesta de charla para CuyoConnect: guía breve sobre qué incluir y formulario para contar el tema, la audiencia y la duración estimada.'
const supabaseUrl =
  import.meta.env.PUBLIC_SUPABASE_URL ?? import.meta.env.VITE_SUPABASE_URL ?? ''
const supabaseAnonKey =
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY ??
  import.meta.env.VITE_SUPABASE_ANON_KEY ??
  import.meta.env.VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY ??
  ''
---

<BaseLayout title={title} description={description} canonical="/speakers">
  <div class="flex min-h-[100svh] flex-col">
    <SiteHeader client:load pathname="/speakers" />
    <main
      class="flex min-h-0 flex-1 flex-col lg:justify-center"
    >
      <SpeakersIsland
        client:load
        supabaseUrl={supabaseUrl}
        supabaseAnonKey={supabaseAnonKey}
      />
    </main>
  </div>
</BaseLayout>
