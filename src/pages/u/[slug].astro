---
/**
 * Perfiles públicos como HTML estático en cada deploy.
 * Contenido actualizado: redeploy (p. ej. cron diario en Vercel) o al mergear a main.
 */
export const prerender = true

import { MemberProfilePage } from '@/MemberProfilePage'
import { SiteHeader } from '@/SiteHeader'
import BaseLayout from '@/layouts/BaseLayout.astro'
import {
  fetchPublicMemberProfileBySlug,
  fetchPublicProfileSlugsForPrerender,
} from '@/lib/member-profile-server'
import {
  getMemberDisplayName,
  getMemberOgAvatarUrl,
  getMemberPublicMetaDescription,
} from '@/lib/member-profiles'

export async function getStaticPaths() {
  const slugs = await fetchPublicProfileSlugsForPrerender()
  return slugs.map((slug) => ({ params: { slug } }))
}

const slug = Astro.params.slug ?? ''
let profile = null
let loadError = ''

try {
  profile = await fetchPublicMemberProfileBySlug(slug)
} catch (error) {
  console.error('No se pudo cargar el perfil publico.', error)
  loadError = 'No pudimos cargar este perfil. Intenta de nuevo en unos minutos.'
}

Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate')
Astro.response.headers.set(
  'Vercel-CDN-Cache-Control',
  'public, s-maxage=86400, stale-while-revalidate=604800',
)

const title = profile
  ? `${getMemberDisplayName(profile)} — CuyoConnect`
  : loadError
    ? 'CuyoConnect'
    : `${slug ? `@${slug} — ` : ''}CuyoConnect`

const description = profile
  ? getMemberPublicMetaDescription(profile)
  : loadError
    ? 'No pudimos cargar este perfil. Volvé a intentar en unos minutos.'
    : 'Este perfil no está disponible o es privado. CuyoConnect es la comunidad tech del Cuyo: eventos, meetups y más.'

const memberOgImage = profile ? getMemberOgAvatarUrl(profile) : null
---

<BaseLayout
  title={title}
  description={description}
  canonical={`/u/${slug}`}
  ogImage={memberOgImage ?? undefined}
  ogImageWidth={memberOgImage ? 512 : undefined}
  ogImageHeight={memberOgImage ? 512 : undefined}
  twitterCard={memberOgImage ? 'summary' : 'summary_large_image'}
>
  <SiteHeader client:load pathname={`/u/${slug}`} />
  <main>
    <MemberProfilePage client:load slug={slug} initialProfile={profile} initialError={loadError} />
  </main>
</BaseLayout>
