{
  "crons": [
    {
      "path": "/api/github-map-refresh",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/member-profiles-sync",
      "schedule": "0 8 * * 1"
    }
  ],
  "functions": { 
    "api/github-map-refresh.ts": {
      "maxDuration": 300
    },
    "api/member-profiles-sync.ts": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/events/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/team/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/partners/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/recursos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/banner/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
